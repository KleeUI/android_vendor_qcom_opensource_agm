cc_library_shared {
    name: "libagmmixer",
    owner: "qti",
    vendor: true,
    compile_multilib: "64",
    cflags: [
        "-Wno-unused-parameter",
        "-Wno-unused-result",
    ],
    srcs: ["agmmixer.c"],
    include_dirs: [
        "vendor/qcom/opensource/pal/session/inc",
    ],
    header_libs: [
        "libagm_headers",
        "libacdb_headers",
    ],
    shared_libs: [
        "libtinyalsa",
        "libexpat",
    ],
}

cc_defaults {
    name: "agm_test_defaults",
    vendor: true,
    compile_multilib: "64",
    cflags: [
        "-Wno-unused-parameter",
        "-Wno-unused-result",
        "-DBACKEND_CONF_FILE=\"/vendor/etc/backend_conf.xml\"",
    ],
    header_libs: [
        "libagm_headers",
        "libarosal_headers",
        "libacdb_headers",
    ],
    shared_libs: [
        "libagmmixer",
        "libtinyalsa",
    ],
    include_dirs: [
        "vendor/qcom/opensource/pal/session/inc",
    ],
}

cc_binary {
    name: "agmplay",
    defaults: ["agm_test_defaults"],
    srcs: ["agmplay.c"],
}

cc_binary {
    name: "agmcap",
    defaults: ["agm_test_defaults"],
    srcs: ["agmcap.c"],
}

cc_binary {
    name: "agmcompressplay",
    defaults: ["agm_test_defaults"],
    srcs: ["agmcompressplay.c"],
    include_dirs: [
        "vendor/qcom/opensource/pal/session/inc",
        "external/tinycompress/include",
    ],
    shared_libs: [
        "libagmmixer",
        "libtinyalsa",
        "libtinycompress",
    ],
}
