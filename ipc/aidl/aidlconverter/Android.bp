cc_library_static {
    name: "libagmaidltypeconverter",
    owner: "qti",
    vendor: true,
    compile_multilib: "64",
    cflags: [
        "-v",
        "-Wall",
        "-Wextra",
        "-Wthread-safety",
    ],
    tidy: true,
    local_include_dirs: ["inc"],
    include_dirs: [
        "vendor/qcom/opensource/agm/service/inc/public",
        "vendor/qcom/opensource/audioreach/graphservices/gsl/api",
    ],
    export_include_dirs: ["inc"],
    srcs: [
        "src/AgmLegacyToAidl.cpp",
        "src/AgmAidlToLegacy.cpp",
    ],
    static_libs: ["libaidlcommonsupport"],
    shared_libs: [
        "liblog",
        "libbinder_ndk",
        "libbase",
        "libcutils",
        "libutils",
        "libar-gsl",
        "vendor.qti.hardware.agm-V1-ndk",
    ],
    header_libs: ["libagm_headers"],
}
